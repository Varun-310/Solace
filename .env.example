# Solace Environment Configuration
# Copy this to backend/.env and fill in your values

# Application
APP_NAME=Solace
DEBUG=false

# Groq Cloud LLM (get free key at https://console.groq.com)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.1-8b-instant
GROQ_FALLBACK_MODEL=gemma2-9b-it

# Context Settings
CONTEXT_WINDOW=6
MAX_RESPONSE_TOKENS=250

# Database (Supabase PostgreSQL)
# Get from: Supabase Dashboard → Settings → Database
DB_HOST=aws-0-region.pooler.supabase.com
DB_PORT=5432
DB_USER=postgres.your-project-ref
DB_PASSWORD=your-database-password
DB_NAME=postgres

# Redis (optional — falls back to in-memory if unavailable)
REDIS_URL=redis://localhost:6379

# Encryption (CHANGE THIS to a random 32+ char string)
ENCRYPTION_SECRET=generate-a-random-string-here-32-chars-plus

# Email (Gmail SMTP for password reset)
SMTP_EMAIL=
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
